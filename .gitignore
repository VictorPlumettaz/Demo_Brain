# Private folder stays local — but keep the README so the structure is visible
07_private/*
!07_private/README.md

# Claudian conversation history. This is a PUBLIC repo — chat transcripts stay local.
.claudian/

# The skills themselves live at 00_system/skills/ and ARE tracked — they are part
# of the demo. What is ignored is only the link folder Claude Code loads from:
# those links are per-machine and get created by 00_system/skills_link.ps1.
# Tracking them used to break every Windows clone (git stores a symlink as a
# 42-byte text file when core.symlinks is off, and Claude Code loads nothing).
.claude/skills/

# Claudian's own data.json holds the chat history, not settings. Public repo.
.obsidian/plugins/realclaudian/data.json

# Plugin CODE is not ours to redistribute. Tracked per plugin are only
# manifest.json (which plugin, which version) and data.json (our settings) —
# both small, both ours to share. The bundles are not:
#   - obsidian-style-settings has NO licence at all, so redistribution is simply
#     not permitted
#   - Templater is AGPL-3.0 and front-matter-title is GPL-3.0 — copyleft, which
#     drags obligations onto this repo
#   - dataview, BRAT and Claudian are MIT, which allows redistribution but only
#     together with the licence text, which was never included
# They were swept in by 77a01ff on 2026-08-03 (5.5 MB, zero licence files) and
# taken back out on 2026-08-16. Install the plugins from the store or via BRAT —
# the README says which.
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# Obsidian workspace state (per-device, not worth syncing)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Themes are part of the demo setup and must be tracked
# (no theme files to exclude)

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Generated invoices. The markdown source and the ledger are the truth and stay in git;
# the PDF is reproducible from them in one command, and a binary that changes on every
# regeneration bloats the history for nothing.
03_areas/billing/pdf/

# Binaries do not belong in a text repo
*.exe
*.dll
*.msi
*.zip
node_modules/

# Audio: transcribe it, then delete it
*.m4a
*.mp3
*.wav
